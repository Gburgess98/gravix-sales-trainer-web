{
  "name": "gravix-sales-trainer-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "smoke:proxy": "bash scripts/smoke-proxy-auth.sh",
    "validate-sprint-4-manager-audit": "bash scripts/validate-sprint-4-manager-audit.sh",
    "validate-sprint-4-day-90": "bash scripts/validate-sprint-4-day-90.sh",
    "validate-sprint-4-day-91": "bash scripts/validate-sprint-4-day-91.sh",
    "validate-sprint-4-day-92": "bash scripts/validate-sprint-4-day-92.sh",
    "check:proxy": "bash scripts/check-no-raw-proxy-fetch.sh",
    "check": "npm run typecheck && npm run lint && npm run check:proxy",
    "check:ci": "npm run typecheck && npm run lint && npm run check:proxy",
    "test": "echo \"No unit tests yet — use test:e2e for E2E tests\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:e2e:debug": "playwright test --debug"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,css,md}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.544.0",
    "next": "15.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.63.0",
    "recharts": "^3.8.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
